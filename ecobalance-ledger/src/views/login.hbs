<section class="container py-5" style="max-width:480px">
  <div class="card shadow">
    <div class="card-body p-4">
      <h1 class="h3">Entrar</h1>
      <p class="text-body-secondary">Acesse com seu e-mail e senha.</p>
      <form id="loginForm">
        <input type="hidden" name="next" value="{{next}}">
        <div class="mb-3">
          <label class="form-label" for="email">E-mail</label>
          <input class="form-control" id="email" name="email" type="email" autocomplete="email" required>
        </div>
        <div class="mb-3">
          <label class="form-label" for="senha">Senha</label>
          <input class="form-control" id="senha" name="senha" type="password" autocomplete="current-password" required>
        </div>
        <div id="formError" class="alert alert-danger" role="alert" hidden></div>
        <button id="submitBtn" class="btn btn-success w-100" type="submit">Entrar</button>
      </form>
      <p class="text-center text-body-secondary mt-3 mb-0">Não tem conta? <a href="/register">Cadastre-se</a></p>
    </div>
  </div>
</section>
