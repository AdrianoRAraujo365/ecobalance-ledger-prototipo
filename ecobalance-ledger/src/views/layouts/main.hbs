<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <meta name="description" content="Calculadora sustentável com Modelo de Leontief, governança ESG e registro encadeado SHA-256.">
  <script src="/js/theme.js"></script>
  <!-- Bootstrap 5 (componentes) + Tailwind (utilitários com prefixo tw-, sem preflight) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/tailwind-config.js"></script>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
</head>
<body class="page-{{active}} d-flex flex-column min-vh-100">
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  {{> navbar}}
  <main id="conteudo" class="flex-grow-1" tabindex="-1">
    {{{body}}}
  </main>
  <footer class="eb-footer border-top py-4 mt-4">
    <div class="container small text-body-secondary">
      <p class="mb-1">© {{year}} EcoBalance Ledger · Projeto acadêmico Fatec Zona Leste (DSM) · Adriano Rodrigues de Araujo, Gabriel Gomide e Gustavo Henrique Teixeira</p>
      <p class="mb-0">Registro encadeado com SHA-256 em banco relacional: detecta adulteração, mas não é uma blockchain distribuída.</p>
    </div>
  </footer>
  {{#if user}}{{> senha-modal}}{{/if}}
  <div id="toasts" class="toast-container position-fixed bottom-0 end-0 p-3" aria-live="polite" aria-atomic="true"></div>

  <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  {{#if script}}<script src="/js/{{script}}.js"></script>{{/if}}
</body>
</html>
