<div class="modal fade" id="senhaModal" tabindex="-1" aria-labelledby="senhaModalTitulo" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" id="senhaForm">
      <div class="modal-header">
        <h2 class="modal-title h5" id="senhaModalTitulo">Alterar senha</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label" for="senhaAtual">Senha atual</label><input class="form-control" id="senhaAtual" name="senhaAtual" type="password" autocomplete="current-password" required></div>
        <div class="mb-3"><label class="form-label" for="novaSenha">Nova senha</label><input class="form-control" id="novaSenha" name="novaSenha" type="password" autocomplete="new-password" minlength="8" required aria-describedby="novaAjuda"><div id="novaAjuda" class="form-text">Mínimo de 8 caracteres, com letras e números.</div></div>
        <div class="mb-3"><label class="form-label" for="confirmaSenha">Confirmar nova senha</label><input class="form-control" id="confirmaSenha" name="confirma" type="password" autocomplete="new-password" required></div>
        <div id="senhaError" class="alert alert-danger mb-0" role="alert" hidden></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-success">Salvar</button>
      </div>
    </form>
  </div>
</div>
