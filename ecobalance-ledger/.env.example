NODE_ENV=development
APP_PORT=3000

DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecobalance_ledger
DB_USER=ecobalance
DB_PASSWORD=ecobalance123

# Gere cada segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET (login de usuários) e OAUTH_SECRET (tokens de integração) DEVEM ser diferentes.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-1
JWT_EXPIRES_IN=8h
OAUTH_SECRET=troque-por-outro-segredo-longo-e-aleatorio-2
OAUTH_ACCESS_TTL=3600

# Use true somente atrás de HTTPS
COOKIE_SECURE=false

# Gerente de Sustentabilidade inicial (configure a senha localmente; não a versione)
ADMIN_NOME=Administrador EcoBalance
ADMIN_EMAIL=adm-ecobalance@gmail.com
ADMIN_PASSWORD=

# Limite de triagem para alertas internos GLOBALG.A.P. (indicador conformidade: 0-100)
GLOBALGAP_COMPLIANCE_THRESHOLD=80

# Motor NumPy (opcional). Sem estas duas linhas, o cálculo usa o fallback em JavaScript.
# PY_API_KEY deve ser IDÊNTICA no Node e no Python (mínimo 16 caracteres).
PYTHON_API_URL=http://127.0.0.1:5001
PY_API_KEY=troque-pela-chave-interna-node-python

# Dados de demonstração (série 2015–2026 + um usuário por perfil)
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# Opcional: cria as tabelas sem migrations (apenas desenvolvimento)
DB_SYNC=false
